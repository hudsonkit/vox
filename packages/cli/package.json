{
  "name": "@voxd/cli",
  "version": "0.5.2",
  "type": "module",
  "description": "Command-line tools for local transcription and text-to-speech with Vox.",
  "bin": {
    "vox": "./dist/index.js"
  },
  "files": [
    "dist",
    "plugins",
    "scripts/verify-provider-bundles.mjs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arach/vox.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "dependencies": {
    "@voxd/sdk": "0.5.2"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm",
    "prepack": "node scripts/verify-provider-bundles.mjs"
  }
}
